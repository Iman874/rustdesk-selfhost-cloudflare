# Copy ke .env lalu isi

# Domain / IP publik VPS kamu (tanpa port). Contoh: rustdesk.iman874.my.id atau 203.0.113.10
RELAY_HOST=rustdesk.example.com

# Tag image, pin biar tidak ke-update otomatis ke latest yang belum diuji
# Rekomendasi stabil per 2026-08: 1.1.16
RUSTDESK_TAG=latest

# Cloudflare Tunnel ID (didapat setelah `cloudflared tunnel create rustdesk-tunnel`)
TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TUNNEL_NAME=rustdesk-tunnel
